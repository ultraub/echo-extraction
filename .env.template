# Credentials for cloud-API extraction (copy to `.env` and fill in).
# `.env` is gitignored; never commit real keys.
#
#   cp .env.template .env
#
# The runner loads this file at startup. Only needed for cloud-API mode;
# local self-hosted inference needs no keys.

# ── Option 1: Azure OpenAI / Azure AI Foundry ───────────────────────────────
# For Foundry-style v1 endpoints (URL ends in /openai/v1), pass the endpoint
# to the runner via --api-base and the key is read from here.
AZURE_OPENAI_API_KEY=

# ── Option 2: Any other OpenAI-compatible endpoint ──────────────────────────
# OPENAI_API_KEY is the standard variable the OpenAI SDK looks for.
# OPENAI_API_KEY=
